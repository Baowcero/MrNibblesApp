# Copy to apps/api/.env
PORT=4000
DATABASE_URL=postgresql://nibbles:nibbles@localhost:5433/nibbles?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PAYSTACK_SECRET_KEY=sk_test_xxx
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
TZ=Africa/Lagos
# Optional: first CEO account created by `npm run prisma:seed`
SEED_CEO_NAME=
SEED_CEO_PHONE=+234
SEED_CEO_PASSWORD=
# Paystack: test key from the Paystack dashboard (Settings > API Keys). The webhook URL goes in the same page.
PAYSTACK_CALLBACK_URL=
# Paystack needs an email per payment; customers only have a phone, so one is made from the phone number.
PAYSTACK_EMAIL_DOMAIN=customers.mrnibbles.app
# Delivery photos (local disk for now; Spaces later)
STORAGE_DIR=./storage
