# Copy to apps/api/.env
PORT=4000
DATABASE_URL=postgresql://nibbles:nibbles@localhost:5433/nibbles?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PAYSTACK_SECRET_KEY=sk_test_xxx
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
TZ=Africa/Lagos
# Optional: first CEO account created by `npm run prisma:seed`
SEED_CEO_NAME=
SEED_CEO_PHONE=+234
SEED_CEO_PASSWORD=
# Paystack: test key from the Paystack dashboard (Settings > API Keys). The webhook URL goes in the same page.
# Where Paystack sends the customer after paying. This API's own page bounces them back into the app:
# http://<your-computer-ip>:4000/v1/payments/return (testing on a phone) or https://api.yourdomain.com/v1/payments/return (live)
PAYSTACK_CALLBACK_URL=
# Paystack needs an email per payment; customers only have a phone, so one is made from the phone number.
PAYSTACK_EMAIL_DOMAIN=customers.mrnibbles.app
# Delivery photos (local disk for now; Spaces later)
STORAGE_DIR=./storage

# ---- Security (production)
# Browser addresses allowed to call the API directly, comma separated. Phone apps and the dashboard's server need none, so this can stay empty.
CORS_ORIGINS=
# Set when the API sits behind a load balancer or proxy (1 = one proxy), so rate limits see the real client address.
TRUST_PROXY=
# Request limits per minute. Defaults are fine for normal use; raise them only on a TEST server used for load testing.
RATE_LIMIT_IP_PER_MIN=1200
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=30
NODE_ENV=development
